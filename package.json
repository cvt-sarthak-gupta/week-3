{
  "name": "pulseboard",
  "version": "0.1.0",
  "description": "Multi-tenant SaaS monitoring backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:ingest-worker": "tsx watch src/bin/ingest-worker.ts",
    "dev:change-stream-worker": "tsx watch src/bin/change-stream-worker.ts",
    "dev:alert-worker": "tsx watch src/bin/alert-worker.ts",
    "dev:jobs": "tsx watch src/bin/jobs.ts",
    "build": "tsc --project tsconfig.json",
    "start:api": "node dist/bin/api.js",
    "start:ingest-worker": "node dist/bin/ingest-worker.js",
    "start:change-stream-worker": "node dist/bin/change-stream-worker.js",
    "start:alert-worker": "node dist/bin/alert-worker.js",
    "start:jobs": "node dist/bin/jobs.js",
    "migrate": "node --env-file=.env --import tsx/esm migrations/run.ts",
    "seed": "node --env-file=.env --import tsx/esm seed/index.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:load": "tsx tests/load/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "mongodb": "^6.7.0",
    "nanoid": "^5.0.7",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
