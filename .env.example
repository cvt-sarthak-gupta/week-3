# ─────────────────────────────────────────────────────────────────────────────
# PulseBoard — environment variable reference
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────

# Application runtime environment. Affects logging format and error verbosity.
# Values: development | production | test
NODE_ENV=development

# Pino log level. Values: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── API Server ────────────────────────────────────────────────────────────────

# TCP port the Fastify HTTP server listens on.
# Default: 3000
API_PORT=3000

# ── JWT ──────────────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign access tokens. Must be at least 32 characters.
JWT_SECRET=replace_me_with_at_least_32_random_characters

# Lifespan of an access token (parsed by ms / @fastify/jwt).
# Default: 15m
JWT_EXPIRY=15m

# Lifespan of a refresh token stored in Redis.
# Default: 7d
JWT_REFRESH_EXPIRY=7d

# ── PostgreSQL ────────────────────────────────────────────────────────────────

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pulseboard
PG_USER=postgres
PG_PASSWORD=postgres

# Minimum idle connections kept open in the pool.
# Default: 2
PG_POOL_MIN=2

# Maximum simultaneous connections per process.
# Default: 10
PG_POOL_MAX=10

# ── MongoDB ───────────────────────────────────────────────────────────────────

# Full MongoDB connection string, including replica-set parameter for change streams.
# Example: mongodb://localhost:27017/?replicaSet=rs0
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0

# Name of the MongoDB database to use.
MONGO_DB_NAME=pulseboard

# ── Elasticsearch ─────────────────────────────────────────────────────────────

# Base URL of the Elasticsearch node (or load-balancer).
# Default (Docker): http://elasticsearch:9200
ES_URL=http://localhost:9200

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379

# ── Ingest Worker ─────────────────────────────────────────────────────────────

# Number of Redis Stream messages processed concurrently per ingest-worker instance.
# Default: 3
WORKER_CONCURRENCY=3

# Milliseconds after which a pending (claimed) stream message is re-claimed
# by another worker on the next poll cycle.
# Default: 30000 (30 s)
XPENDING_RECLAIM_MS=30000

# Maximum number of entries retained per Redis Stream before trimming (MAXLEN ~).
# Default: 1000000
STREAM_MAX_LEN=1000000

# ── Cache ─────────────────────────────────────────────────────────────────────

# Default TTL in seconds for Redis-cached API responses.
# Default: 300 (5 min)
CACHE_DEFAULT_TTL_SECONDS=300
