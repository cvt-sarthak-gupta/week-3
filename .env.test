NODE_ENV=test

# PostgreSQL — test-isolated port 5433
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=pulseboard_test
PG_USER=postgres
PG_PASSWORD=postgres
PG_POOL_MIN=1
PG_POOL_MAX=5

# MongoDB — test-isolated port 27018
MONGO_URL=mongodb://localhost:27018/?directConnection=true
MONGO_DB_NAME=pulseboard_test
TEST_MONGO_URL=mongodb://localhost:27018/?directConnection=true
TEST_MONGO_DB=pulseboard_test

# Elasticsearch — test-isolated port 9201
ES_URL=http://localhost:9201

# Redis — test-isolated port 6380
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth — 32-char minimum secret
JWT_SECRET=test-secret-for-pulseboard-tests-ok
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Skip real Docker stop/start degradation tests in normal CI
SKIP_DOCKER_DEGRADATION=1
